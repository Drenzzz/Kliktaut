# ======================
# Application
# ======================
APP_NAME=Kliktaut
APP_ENV=development
APP_PORT=3000
BASE_URL=http://localhost:3000

# ======================
# Database (PostgreSQL)
# ======================
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=kliktaut
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Jakarta

# ======================
# Redis
# ======================
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_PASSWORD=
REDIS_DB=0

# ======================
# Security
# ======================
API_KEY=change-this-to-a-very-long-and-secure-key
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REDIRECT_MAX=300
RATE_LIMIT_REDIRECT_WINDOW_SECONDS=60

# ======================
# Optional
# ======================
SHORT_CODE_LENGTH=7
CACHE_TTL_SECONDS=3600
